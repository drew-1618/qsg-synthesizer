# Copy to .env to enable the real qsg_extractor subagent call (app/services/orchestrator.py).
# Without either key set below, extraction silently falls back to the deterministic
# heuristic parser - the API still works, but documents never route through an LLM.
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY - useful for local testing against Gemini's free
# tier instead of burning Anthropic usage. If both keys are set, Anthropic is used
# unless LLM_PROVIDER below says otherwise.
GEMINI_API_KEY=

# Force a specific provider when both API keys above are set: "anthropic" or
# "gemini". Leave unset to auto-detect (Anthropic wins if both keys are present).
# Naming a provider whose key/package isn't available falls back to the heuristic
# parser - it never silently uses the other provider instead.
LLM_PROVIDER=

# Optional HTTP Basic Auth (app/services/auth.py). Leave both unset for open access
# (the default for local dev and the test suite). Set both before deploying anywhere
# reachable beyond localhost - /healthz stays open either way for health checks.
APP_USERNAME=
APP_PASSWORD=

# Behind a reverse proxy, the rate limits (app/services/rate_limiter.py) and auth logs
# see the proxy's address for every request unless uvicorn trusts its
# X-Forwarded-For header. Uvicorn reads this variable itself: set it to the proxy's IP
# (it defaults to 127.0.0.1). Left commented out because an empty value trusts no proxy.
# FORWARDED_ALLOW_IPS=10.0.0.5

# Log verbosity (app/logging_config.py). Defaults to INFO if unset. Set to DEBUG to
# also see which extraction path (LLM vs heuristic) each request took.
LOG_LEVEL=

# Comparison-history storage directory (app/services/history.py). Defaults to
# <repo>/data/history if unset. Point this at a scratch directory when running a
# second/throwaway server instance (manual verification, a script, CI) alongside
# an already-running dev server, so the two don't share and clobber the same
# on-disk history.
HISTORY_DIR=
