# Copy to .env to enable the real qsg_extractor subagent call (app/services/orchestrator.py).
# Without this set, extraction silently falls back to the deterministic heuristic
# parser - the API still works, but documents never route through the LLM subagent.
ANTHROPIC_API_KEY=

# Optional HTTP Basic Auth (app/services/auth.py). Leave both unset for open access
# (the default for local dev and the test suite). Set both before deploying anywhere
# reachable beyond localhost - /healthz stays open either way for health checks.
APP_USERNAME=
APP_PASSWORD=

# Log verbosity (app/logging_config.py). Defaults to INFO if unset. Set to DEBUG to
# also see which extraction path (LLM vs heuristic) each request took.
LOG_LEVEL=
