# Version control
.git
.gitignore

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
env/
venv/
ENV/

# Secrets
.env
*.pem
*.key

# Tests and other non-runtime content
# (NOTE: do not exclude *.md globally - .claude/agents/*.md prompts are
# copied into the image and read at runtime by app/services/orchestrator.py)
# (NOTE: do not exclude sample_docs/ - its PDFs are copied into the image
# and served at runtime by the GET /api/v1/samples demo endpoint)
tests/
sample_docs/*.md
sample_docs/generate_samples.py
README.md

# Docker / editor / OS artifacts
.docker/
.dockerignore
Dockerfile
docker-compose.yml
.vscode/
.idea/
.DS_Store

# Third-party agent skills (symlinks into .agents/, not needed at runtime)
.agents/
.claude/skills/
