# copied into the image and read at runtime by app/services/orchestrator.py)
tests/
sample_docs/
README.md

# Docker / editor / OS artifacts
.docker/
.dockerignore
Dockerfile
docker-compose.yml
.vscode/
.idea/
.DS_Store
